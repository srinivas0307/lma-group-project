digraph G {
graph [rankdir=TB, bgcolor="transparent", nodesep=0.16, ranksep=0.12, pad=0.10];
node [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", color="#7995a7", fillcolor="#edf3f7", margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=10, color="#627d8c", arrowsize=0.65];
U [label="User request", shape=box, fillcolor="#edf3f7"];
D [label="Input dataset", shape=cylinder, fillcolor="#edf3f7"];
BEF [label="Before snapshot\nread-only, index = row id", shape=cylinder, fillcolor="#edf3f7"];
SCH [label="Schema extractor\ncolumns, dtypes, nulls, sample\nrows", shape=box, fillcolor="#edf3f7"];
P [label="Intent parser\nfine-tuned Qwen2.5-1.5B / 3B,\nQLoRA", shape=box, fillcolor="#edf3f7"];
CV [label="Contract validator\nstrict schema + columns exist", shape=diamond, fillcolor="#edf3f7"];
C [label="Intent contract\nread-only", shape=cylinder, fillcolor="#edf3f7"];
G [label="Code generator\nQwen2.5-3B / 1.5B\ncontract-aware prompt", shape=box, fillcolor="#edf3f7"];
SC [label="AST safety guard", shape=diamond, fillcolor="#edf3f7"];
SB [label="Sandbox executor\nseparate process, limits", shape=box, fillcolor="#edf3f7"];
AFT [label="After snapshot", shape=cylinder, fillcolor="#edf3f7"];
V [label="Intent verifier\nrow alignment + 11 predicates", shape=diamond, fillcolor="#edf3f7"];
ACC [label="ACCEPT", shape=box, fillcolor="#e5f3e9"];
ESC [label="ESCALATE\nhand off to a human", shape=box, fillcolor="#fff2d5"];
FR [label="Failure report\nviolated predicates + example\nrows", shape=box, fillcolor="#edf3f7"];
REJ [label="REJECT", shape=box, fillcolor="#fcebea"];
RA [label="Repair agent\nattempt memory, limits", shape=box, fillcolor="#edf3f7"];
TR [label="Tool registry\ninspect_dataset,\nprofile_column,\ndiff_datasets,\nrun_transformation,\nrun_verifier", shape=box, fillcolor="#edf3f7"];
D -> BEF [label=""];
BEF -> SCH [label=""];
U -> P [label=""];
SCH -> P [label=""];
P -> CV [label=""];
CV -> ESC [label="invalid"];
CV -> C [label="valid"];
U -> G [label=""];
SCH -> G [label=""];
C -> G [label="contract input*"];
G -> SC [label=""];
SC -> SB [label="allowed"];
BEF -> SB [label=""];
SB -> AFT [label="ok"];
BEF -> V [label=""];
AFT -> V [label=""];
C -> V [label=""];
SC -> FR [label="blocked"];
SB -> FR [label="crash / timeout"];
V -> ACC [label="PASS"];
V -> ESC [label="UNCERTAIN"];
V -> FR [label="VIOLATION"];
FR -> REJ [label="budget used up"];
FR -> RA [label="attempts left, max 3"];
RA -> TR [label="validated tool calls", dir=both];
RA -> SC [label="propose_fix: revised code"];
RA -> ESC [label="escalate"];
{rank=same; D; U;}
{rank=same; RA; TR; REJ;}
RA -> TR [constraint=false, style=invis];
}