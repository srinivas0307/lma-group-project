digraph G {
graph [rankdir=TB, bgcolor="transparent", nodesep=0.28, ranksep=0.38, pad=0.10];
node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#7995a7", fillcolor="#edf3f7", margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=8, color="#627d8c", arrowsize=0.65];
R [label="User request", shape=box, fillcolor="#edf3f7"];
S [label="Dataset schema\ncolumns, dtypes, nulls, 5 rows", shape=box, fillcolor="#edf3f7"];
G [label="Code generator\nQwen2.5-3B / 1.5B\nprompt b1-v1", shape=box, fillcolor="#edf3f7"];
SC [label="AST safety guard", shape=diamond, fillcolor="#edf3f7"];
REJ [label="REJECT", shape=box, fillcolor="#fcebea"];
SB [label="Sandbox\nseparate process,\nCPU / memory / time limits", shape=box, fillcolor="#edf3f7"];
D [label="Before data", shape=cylinder, fillcolor="#edf3f7"];
ACC [label="ACCEPT output\nno verification", shape=box, fillcolor="#e5f3e9"];
R -> G [label=""];
S -> G [label=""];
G -> SC [label=""];
SC -> REJ [label="blocked"];
SC -> SB [label="allowed"];
D -> SB [label=""];
SB -> REJ [label="crash / timeout"];
SB -> ACC [label="ran"];
}