digraph G {
graph [rankdir=TB, bgcolor="transparent", nodesep=0.28, ranksep=0.38, pad=0.10];
node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#7995a7", fillcolor="#edf3f7", margin="0.12,0.08"];
