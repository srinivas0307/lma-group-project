POOL [label="Frozen candidate pool\nsame programs as Baseline 1", shape=cylinder, fillcolor="#edf3f7"];
SC [label="AST safety guard", shape=diamond, fillcolor="#edf3f7"];
REJ [label="REJECT", shape=box, fillcolor="#fcebea"];
SB [label="Sandbox", shape=box, fillcolor="#edf3f7"];
D [label="Before data", shape=cylinder, fillcolor="#edf3f7"];
M [label="Measure\nschema, rows, nulls, dtypes,\nuniqueness, ranges,\ndistribution", shape=box, fillcolor="#edf3f7"];
J [label="Judge against\nthresholds tuned on dev", shape=diamond, fillcolor="#edf3f7"];
T [label="Frozen thresholds", shape=cylinder, fillcolor="#edf3f7"];
ACC [label="ACCEPT", shape=box, fillcolor="#e5f3e9"];
