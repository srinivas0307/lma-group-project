ipdata_2026-01.csv"}, {"id": "taxi_col_004", "split": "test", "dataset": "taxi", "transformation_type": "column_transformation", "difficulty": "easy", "request": "Round trip_distance to 1 decimal place.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_col_005", "split": "test", "dataset": "taxi", "transformation_type": "column_transformation", "difficulty": "hard", "request": "Add a column fare_per_mile equal to fare_amount divided by trip_distance. For trips with a distance of 0 the value should be missing.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_col_006", "split": "dev", "dataset": "taxi", "transformation_type": "column_transformation", "difficulty": "medium", "request": "Rename the Airport_fee column to airport_fee.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_conv_001", "split": "test", "dataset": "taxi", "transformation_type": "type_conversion", "difficulty": "medium", "request": "Convert tpep_pickup_datetime into a proper datetime column. The pickup and dropoff times are text in the form YYYY-MM-DD HH:MM:SS (for example 2026-01-01 00:54:04).", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_conv_002", "split": "test", "dataset": "taxi", "transformation_type": "type_conversion", "difficulty": "hard", "request": "Convert both tpep_pickup_datetime and tpep_dropoff_datetime into proper datetime columns. The pickup and dropoff times are text in the form YYYY-MM-DD HH:MM:SS (for example 2026-01-01 00:54:04).", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_conv_003", "split": "test", "dataset": "taxi", "transformation_type": "type_conversion", "difficulty": "easy", "request": "Store passenger_count as an integer instead of a float.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_conv_004", "split": "test", "dataset": "taxi", "transformation_type": "type_conversion", "difficulty": "easy", "request": "Make VendorID a categorical column.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_conv_005", "split": "test", "dataset": "taxi", "transformation_type": "type_conversion", "difficulty": "hard", "request": "Convert store_and_fwd_flag to a boolean column: True for 'Y' and False for 'N'.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_conv_006", "split": "dev", "dataset": "taxi", "transformation_type": "type_conversion", "difficulty": "easy", "request": "Store RatecodeID as an integer instead of a float.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_dedup_001", "split": "test", "dataset": "taxi", "transformation_type": "deduplication", "difficulty": "medium", "request": "Trips with the same VendorID, pickup time and dropoff time are duplicates. Keep only the first of each.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_dedup_002", "split": "test", "dataset": "taxi", "transformation_type": "deduplication", "difficulty": "hard", "request": "Trips with the same VendorID, pickup time and dropoff time are duplicates. Keep only the last one of each.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_dedup_003", "split": "test", "dataset": "taxi", "transformation_type": "deduplication", "difficulty": "hard", "request": "Rows that match in every column except the money columns (fare_amount, extra, mta_tax, tip_amount, tolls_amount, improvement_surcharge, total_amount, congestion_surcharge, Airport_fee, cbd_congestion_fee) are duplicates. Keep only the first of each.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_dedup_004", "split": "test", "dataset": "taxi", "transformation_type": "deduplication", "difficulty": "medium", "request": "Treat trips with the same pickup time and the same pickup location (PULocationID) as duplicates; keep the first.", "data_file": "data/yellow_tripdata_2026-01.csv"}, {"id": "taxi_dedup_005", "split": "test", "dataset": "taxi", "transformation_type": "deduplication", "difficulty": "medium", "request": "Kee