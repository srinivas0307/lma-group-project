{"id": "smoke_dedup_013", "source_dataset": "smoke_shop", "data_file": "finetune/datasets/smoke_shop.csv", "transformation_type": "deduplication", "pattern": "dedup_except_first", "style": "plain", "request": "Orders with the same customer, category, quantity, unit_price and coupon are duplicates; keep the first one.", "contract": {"contract_version": "1.0", "must_change": [{"type": "duplicate_count", "target": "*", "except": ["order_id"], "op": "eq", "value": 0, "keep": "first"}, {"type": "row_count", "target": null, "op": "decreased"}], "must_preserve": [{"type": "columns_unchanged", "target": "*", "except": []}]}, "reference_code": "def transform(df):\n    keys = [c for c in df.columns if c != 'order_id']\n    return df.drop_duplicates(subset=keys, keep='first').copy()\n"}
