{"id": "smoke_miss_018", "source_dataset": "smoke_shop", "data_file": "finetune/datasets/smoke_shop.csv", "transformation_type": "missing_values", "pattern": "fill_const", "style": "casual", "request": "where there's no coupon put NONE", "contract": {"contract_version": "1.0", "must_change": [{"type": "column_value_relation", "target": "coupon", "where": {"column": "coupon", "op": "is_null"}, "fn": "const", "args": [{"lit": "NONE"}]}, {"type": "null_count", "target": "coupon", "op": "eq", "value": 0}], "must_preserve": [{"type": "column_values_unchanged", "target": "coupon", "where": {"column": "coupon", "op": "not_null"}}, {"type": "columns_unchanged", "target": "*", "except": ["coupon"]}, {"type": "row_count", "target": null, "op": "unchanged"}]}, "reference_code": "def transform(df):\n    out = df.copy()\n    out['coupon'] = out['coupon'].fillna('NONE')\n    return out\n"}
